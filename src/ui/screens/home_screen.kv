<HomeScreen>:
    # Set the background color
    md_bg_color: app.colors['bg']

    
    FloatLayout:
        size_hint: 1, 1
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

        MDLabel:
            text: "Welcome to the Home Screen"
            color: 0, 0, 0
            font_size: '24sp'
            adaptive_size: True
            pos_hint: {"center_x": 0.5, "top": 0.8}
        
        MDIcon:
            icon: "shield-check"
            color: app.colors['green']
            theme_font_size: "Custom"
            font_size: "250sp"
            pos_hint: {"center_x": 0.5, "top": 0.75}
        
        MDLabel:
            id: accelerometer_data
            text: f"G:: {root.background_color[0]*30:.2f} m/s²"
            font_size: '18sp'
            color: 0, 0, 0, 1
            adaptive_size: True
            pos_hint: {"center_x": 0.5, "top": 0.45}

        
        MDWidget:
            id: color_display
            size_hint: None, 0.3
            width: self.height
            pos_hint: {"center_x": 0.5, "center_y": 0.1}
            md_bg_color: root.background_color